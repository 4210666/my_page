                  <stop offset="100%" stop-color="#f07850" stop-opacity="0.0"/>
                </linearGradient>
              </defs>
              <line x1="26" y1="102" x2="500" y2="102" stroke="rgba(236,231,220,0.22)" stroke-width="0.8"/>
              <line x1="145" y1="14" x2="145" y2="102" stroke="rgba(60,235,190,0.38)" stroke-width="0.75" stroke-dasharray="2 3"/>
              <line x1="355" y1="14" x2="355" y2="102" stroke="rgba(240,120,80,0.38)" stroke-width="0.75" stroke-dasharray="2 3"/>
              <path id="vieAreaBlue" fill="url(#vieGradBlue)" d=""/>
              <path id="vieAreaRed" fill="url(#vieGradRed)" d=""/>
              <path id="vieCurveBlue" stroke="#3cebbe" stroke-width="2.1" fill="none" d=""/>
              <path id="vieCurveRed" stroke="#f07850" stroke-width="2.1" fill="none" d=""/>
              <text x="145" y="118" text-anchor="middle" fill="#3cebbe" font-family="monospace" font-size="9.5">450 nm · Bent Saddle</text>
              <text x="250" y="118" text-anchor="middle" fill="rgba(236,231,220,0.45)" font-family="monospace" font-size="8.5">λ (nm)</text>
              <text x="355" y="118" text-anchor="middle" fill="#f07850" font-family="monospace" font-size="9.5">610 nm · Planarized</text>
            </svg>
            <div class="vie-controls">
              <div class="vie-slider-label">
                <span id="vieLeftLbl">受限弯曲态 (450nm)</span>
                <span id="vieRightLbl">平面化态 (610nm)</span>
