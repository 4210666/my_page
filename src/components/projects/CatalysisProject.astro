          <div class="cat-kpi accent"><strong>288</strong><span id="kpiRec">条精炼候选记录</span></div>
          <div class="cat-kpi"><strong>100%</strong><span id="kpiAudit">原文页码与审计追溯</span></div>
        </div>
      </div>

