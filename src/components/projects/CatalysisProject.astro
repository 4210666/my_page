          </blockquote>
          <div class="xray-rule-note" id="xrayRule">
            <span>✓ 参考文献隔离通过</span>
            <span>✓ 沸石骨架词表归一：MFI</span>
            <span>✓ 碳数区间校验通过</span>
          </div>
        </div>
        <div class="xray-bridge" aria-hidden="true">
          <svg viewBox="0 0 56 160" fill="none">
            <path class="xb-line" d="M2 28 C28 28, 28 28, 54 28"/>
            <path class="xb-line" d="M2 64 C28 64, 28 64, 54 64"/>
            <path class="xb-line" d="M2 100 C28 100, 28 100, 54 100"/>
            <path class="xb-line" d="M2 136 C28 136, 28 136, 54 136"/>
            <circle class="xb-dot" cx="28" cy="28" r="2.5"/>
            <circle class="xb-dot" cx="28" cy="64" r="2.5"/>
            <circle class="xb-dot" cx="28" cy="100" r="2.5"/>
            <circle class="xb-dot" cx="28" cy="136" r="2.5"/>
          </svg>
        </div>
        <div class="xray-struct">
          <div class="xray-pane-bar">
            <span class="xray-doc" id="xrayRecId">CANDIDATE #084 · audit.json</span>
            <span class="xray-pass" id="xrayStatus">CHEM-RULE PASS ✓</span>
          </div>
          <div class="xray-fields">
            <div class="xray-field" data-hl-target="cat">
              <span class="xf-key">catalyst / framework</span>
              <strong class="xf-val" id="xfCat">H-ZSM-5 (Si/Al=25) · MFI</strong>
            </div>
            <div class="xray-field" data-hl-target="cond">
              <span class="xf-key">reaction_conditions</span>
              <strong class="xf-val" id="xfCond">360 °C · 2.0 MPa · WHSV 1.5 h⁻¹</strong>
            </div>
            <div class="xray-field" data-hl-target="conv">
              <span class="xf-key">conversion_%</span>
              <strong class="xf-val" id="xfConv">96.4% (LDPE feedstock)</strong>
            </div>
            <div class="xray-field" data-hl-target="sel">
              <div class="xf-row">
                <span class="xf-key">C10_C16_jet_selectivity</span>
                <strong class="xf-val accent" id="xfSel">28.5%</strong>
              </div>
              <div class="xf-bar"><div class="xf-bar-fill" id="xfBar" style="width:28.5%"></div></div>
            </div>
          </div>
        </div>
      </div>
