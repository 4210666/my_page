    <!-- ═══ LAB 02: WET-LAB · VIE FLUORESCENCE ═══ -->
    <article class="lab-unit lab-unit-vie uv-active" id="vieLab" aria-labelledby="vieLabTitle">
      <!-- Hidden 365nm UV-Reactive Fluorescent Molecular Watermark -->
      <div class="uv-secret-layer" aria-hidden="true">
        <div class="uv-beam-glow"></div>
        <svg class="uv-chem-svg" viewBox="0 0 920 280" fill="none">
          <!-- Dihydrodibenzo[a,c]phenazine (DPAC) Bent Saddle -> Planarized Skeleton -->
          <g stroke="currentColor" stroke-width="1.25" opacity="0.88">
            <polygon points="88,96 122,76 156,96 156,136 122,156 88,136"/>
            <polygon points="156,96 192,76 226,96 226,136 192,156 156,136"/>
            <polygon points="226,96 260,76 294,96 294,136 260,156 226,136"/>
            <polygon points="134,42 168,22 202,42 192,76 156,76"/>
            <polygon points="192,156 226,156 242,192 208,214 176,192"/>
            <line x1="156" y1="96" x2="156" y2="76" stroke-dasharray="3 2"/>
            <circle cx="156" cy="96" r="3.5" fill="currentColor"/>
            <circle cx="226" cy="136" r="3.5" fill="currentColor"/>
          </g>
          <text x="86" y="242" fill="currentColor" font-family="monospace" font-size="11" letter-spacing="2">DPAC · S₁ BENT (θ ≈ 138°) → S₁ PLANAR (θ ≈ 176°)</text>
          <text x="86" y="260" fill="currentColor" font-family="monospace" font-size="10" opacity="0.75">λ_ex = 365 nm UV · Δν_Stokes = 6,120 cm⁻¹ · RATIOMETRIC DUAL EMISSION</text>

          <g transform="translate(560, 28)" stroke="currentColor" stroke-width="1.1" opacity="0.82">
            <path d="M20 140 C65 140, 75 34, 118 34 C160 34, 168 118, 206 118 C242 118, 255 18, 298 18" stroke-dasharray="4 4"/>
            <circle cx="118" cy="34" r="4" fill="currentColor"/>
            <circle cx="298" cy="18" r="4" fill="currentColor"/>
            <text x="84" y="24" fill="currentColor" font-family="monospace" font-size="10">S₁* (Bent · 450nm)</text>
            <text x="232" y="12" fill="currentColor" font-family="monospace" font-size="10">S₁* (Planar · 610nm)</text>
            <text x="128" y="168" fill="currentColor" font-family="monospace" font-size="10.5" letter-spacing="1.5">VIBRATION-INDUCED PLANARIZATION</text>
          </g>
        </svg>
      </div>

      <div class="lab-unit-bar">
