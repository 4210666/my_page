  ['.footer-copy','张天硕 · 华东理工大学 · 化工学院 · 油气储运工程','Tianshuo Zhang · ECUST · Oil & Gas Storage and Transportation Engineering'],
  ['.visit-label','Visits · 累计访问','Total Visits'],
  ['.visit-unit','次','views']
];

const langBtn = document.getElementById('langToggle');
const applyLang = (lang) => {
  const isEn = lang === 'en';
  document.documentElement.dataset.lang = lang;
  document.documentElement.lang = isEn ? 'en' : 'zh-CN';
  if(langBtn) langBtn.textContent = isEn ? '中' : 'EN';
  if(dateEl) dateEl.textContent = d.toLocaleDateString(isEn ? 'en-US' : 'zh-CN', {year:'numeric', month:'long', day:'numeric'});
  i18nNodes.forEach(([sel, zh, en, html])=>{
    const el = document.querySelector(sel);
    if(!el) return;
    if(html) el.innerHTML = isEn ? en : zh;
    else el.textContent = isEn ? en : zh;
  });
  const qm = document.getElementById('quickMail');
  if(qm){
    const labels = qm.querySelectorAll('label');
    const lblText = isEn ? ['Your Role\n','Your Name\n','Message\n'] : ['您的身份\n','称呼\n','留言\n'];
    labels.forEach((lbl,i)=>{
      const tn = [...lbl.childNodes].find(n=>n.nodeType===Node.TEXT_NODE);
      if(tn && lblText[i]) tn.textContent = lblText[i];
    });
    const whoIn = qm.querySelector('input[name="who"]');
    if(whoIn) whoIn.placeholder = isEn ? 'e.g., Prof. Wang / Research Team' : '如：王老师 / 某某团队';
    const msgIn = qm.querySelector('textarea[name="msg"]');
    if(msgIn) msgIn.placeholder = isEn ? 'Research topic or collaboration idea...' : '想交流的课题或合作方向...';
  }
  const vToggle = document.querySelector('#projects .video-toggle');
  const vLabel = vToggle?.querySelector('.toggle-label');
  if(vToggle && vLabel){
    const paused = vToggle.getAttribute('aria-pressed') === 'true';
    vLabel.textContent = paused ? (isEn ? 'Play' : '播放演示') : (isEn ? 'Pause' : '暂停演示');
  }
  paintScale(curScaleIdx);
  paintNavToggle();
  paintCourseToggle();
  paintRadarInfo(curRadarIdx);
  if(window.__refreshXrayLang) window.__refreshXrayLang();
  const cmdIn = document.getElementById('cmdInput');
  if(cmdIn) cmdIn.placeholder = isEn ? 'Search labs, courses, credentials, or run actions...' : '搜索实验台、课程、证书或执行快捷动作...';
  if(typeof renderCmdList === 'function') renderCmdList();
  if(lbEl?.classList.contains('open')) renderLb();
};

// 12. Command Palette (Cmd+K / Ctrl+K)
const cmdOverlay = document.getElementById('cmdOverlay');
const cmdInput = document.getElementById('cmdInput');
const cmdList = document.getElementById('cmdList');
const cmdTrigger = document.getElementById('cmdTrigger');
const cmdClose = document.getElementById('cmdClose');
let cmdActiveIdx = 0;
let cmdFiltered = [];

const cmdItems = [
  {groupZh:'四幕章节 · Chapters',groupEn:'Chapters',code:'01',zh:'干湿闭环实验台（SAF 催化引擎 + VIE 荧光暗室）',en:'01 Selected Labs (SAF Catalysis + VIE Darkroom)',hint:'#projects',kw:'labs projects catalysis vie 催化 荧光 代表作 实验台',run:()=>{location.hash='#projects';}},
  {groupZh:'四幕章节 · Chapters',groupEn:'Chapters',code:'02',zh:'学术成绩总账（专业排名 1/91 · GPA 3.672 · 91.6）',en:'02 Academic Spec Ledger (Rank 1/91 · GPA 3.672)',hint:'#academics',kw:'academics gpa ledger 学术 成绩 物理化学 电工学 高数',run:()=>{location.hash='#academics';}},
  {groupZh:'四幕章节 · Chapters',groupEn:'Chapters',code:'03',zh:'成长脉络、六维能力星图与证书原件索引',en:'03 Trajectory, 6-Axis Topology & Credentials',hint:'#archive',kw:'archive radar certs cet6 脉络 星图 证书 奖学金',run:()=>{location.hash='#archive';}},
  {groupZh:'四幕章节 · Chapters',groupEn:'Chapters',code:'04',zh:'建立连接 · 邮箱 / 微信 / 上海实时状态',en:'04 Initiate Contact & Live Status',hint:'#contact',kw:'contact email wechat 联系 邮箱 微信 名片',run:()=>{location.hash='#contact';}},
  {groupZh:'快捷动作 · Actions',groupEn:'Quick Actions',code:'⌘',zh:'切换深浅色主题（Light / Dark）',en:'Toggle Light / Dark Theme',hint:'Theme',kw:'theme dark light 主题 深色 浅色',run:()=>themeBtn?.click()},
  {groupZh:'快捷动作 · Actions',groupEn:'Quick Actions',code:'文',zh:'切换中英文界面（ZH / EN）',en:'Switch Language (ZH / EN)',hint:'Lang',kw:'lang english chinese 语言 英文 中文',run:()=>langBtn?.click()},
  {groupZh:'快捷动作 · Actions',groupEn:'Quick Actions',code:'↓',zh:'下载正式简历 PDF',en:'Download Résumé PDF',hint:'PDF',kw:'pdf resume download 下载简历',run:()=>{location.href='/zhangtianshuo-resume.pdf';}},
  {groupZh:'独立页面 · Pages',groupEn:'Standalone Pages',code:'→',zh:'催化文献引擎完整架构页',en:'Catalysis Engine Case Study',hint:'/projects/catalysis',kw:'case study catalysis 详情',run:()=>{location.href='/projects/catalysis';}},
  {groupZh:'独立页面 · Pages',groupEn:'Standalone Pages',code:'→',zh:'一页式在线学术简历',en:'One-Page Web Academic CV',hint:'/resume',kw:'web resume 在线简历',run:()=>{location.href='/resume';}},
  {groupZh:'独立页面 · Pages',groupEn:'Standalone Pages',code:'→',zh:'科研与学习笔记专栏',en:'Research & Study Notes',hint:'/notes',kw:'notes blog 笔记',run:()=>{location.href='/notes';}}
];

function renderCmdList(){
  if(!cmdList) return;
  const isEn = document.documentElement.dataset.lang === 'en';
  const q = (cmdInput?.value || '').trim().toLowerCase();
  cmdFiltered = cmdItems.filter(it=>!q || it.zh.toLowerCase().includes(q) || it.en.toLowerCase().includes(q) || it.kw.includes(q) || it.hint.toLowerCase().includes(q));
  if(cmdActiveIdx >= cmdFiltered.length) cmdActiveIdx = 0;
  let lastGroup = '', html = '';
  cmdFiltered.forEach((it, idx)=>{
    const grp = isEn ? it.groupEn : it.groupZh;
    if(grp !== lastGroup){ lastGroup = grp; html += `<div class="cmd-group">${grp}</div>`; }
    html += `<button type="button" class="cmd-item${idx===cmdActiveIdx?' active':''}" data-cmd-idx="${idx}" role="option" aria-selected="${idx===cmdActiveIdx}">
      <span class="cmd-item-left"><span class="cmd-item-code">${it.code}</span><span class="cmd-item-title">${isEn?it.en:it.zh}</span></span>
      <span class="cmd-item-hint">${it.hint}</span>
    </button>`;
  });
  if(!cmdFiltered.length) html = `<div class="cmd-group" style="padding:1rem;text-align:center;">${isEn?'No matching entries':'未找到匹配条目'}</div>`;
  cmdList.innerHTML = html;
  cmdList.querySelectorAll('.cmd-item').forEach(btn=>{
    btn.addEventListener('pointerenter', ()=>{
      cmdActiveIdx = Number(btn.getAttribute('data-cmd-idx')||0);
      cmdList.querySelectorAll('.cmd-item').forEach((b,i)=>b.classList.toggle('active', i===cmdActiveIdx));
    });
    btn.addEventListener('click', ()=>{
      const item = cmdFiltered[Number(btn.getAttribute('data-cmd-idx')||0)];
      closeCmd(); item?.run();
    });
  });
}

const openCmd = () => {
  if(!cmdOverlay) return;
  cmdOverlay.classList.add('open');
  if(cmdInput) cmdInput.value = '';
  cmdActiveIdx = 0;
  renderCmdList();
  requestAnimationFrame(()=>cmdInput?.focus());
};
const closeCmd = () => cmdOverlay?.classList.remove('open');
cmdTrigger?.addEventListener('click', openCmd);
cmdClose?.addEventListener('click', closeCmd);
cmdOverlay?.addEventListener('click', e=>{ if(e.target===cmdOverlay) closeCmd(); });
cmdInput?.addEventListener('input', ()=>{ cmdActiveIdx = 0; renderCmdList(); });
window.addEventListener('keydown', e=>{
  if((e.metaKey || e.ctrlKey) && e.key.toLowerCase()==='k'){
    e.preventDefault();
    if(cmdOverlay?.classList.contains('open')) closeCmd(); else openCmd();
    return;
  }
  if(!cmdOverlay?.classList.contains('open')) return;
  if(e.key==='Escape'){ e.preventDefault(); closeCmd(); }
  else if(e.key==='ArrowDown' && cmdFiltered.length){ e.preventDefault(); cmdActiveIdx=(cmdActiveIdx+1)%cmdFiltered.length; renderCmdList(); }
  else if(e.key==='ArrowUp' && cmdFiltered.length){ e.preventDefault(); cmdActiveIdx=(cmdActiveIdx-1+cmdFiltered.length)%cmdFiltered.length; renderCmdList(); }
  else if(e.key==='Enter'){ e.preventDefault(); const it=cmdFiltered[cmdActiveIdx]; if(it){ closeCmd(); it.run(); } }
});

if(document.documentElement.dataset.lang === 'en') applyLang('en');
langBtn?.addEventListener('click', ()=>{
  const next = document.documentElement.dataset.lang === 'en' ? 'zh' : 'en';
  try{ localStorage.setItem('lang', next); }catch(e){}
  applyLang(next);
});
</script>
