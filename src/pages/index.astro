<script is:inline>
// 1. Live Date & Snappy 0.9s Shutter Intro
const d = new Date();
const dateEl = document.getElementById('today-date');
if(dateEl) dateEl.textContent = d.toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'});

const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const isFinePointer = window.matchMedia('(hover:hover) and (pointer:fine)').matches;

if(document.documentElement.classList.contains('intro-on')){
  const introEl = document.getElementById('intro');
  let closed = false;
  const closeIntro = () => {
    if(closed) return;
    closed = true;
    document.documentElement.classList.add('intro-closing');
    setTimeout(()=>document.documentElement.classList.remove('intro-on','intro-closing'), 820);
  };
  setTimeout(closeIntro, 960);
  introEl?.addEventListener('click', closeIntro);
  window.addEventListener('keydown', closeIntro, {once:true});
}

// 2. Theme Toggle
const themeBtn = document.getElementById('themeToggle');
const metaTheme = document.querySelector('meta[name="theme-color"]');
const paintTheme = () => {
  const dark = document.documentElement.dataset.theme === 'dark';
  if(themeBtn) themeBtn.textContent = dark ? '☀' : '☾';
  if(metaTheme) metaTheme.setAttribute('content', dark ? '#151311' : '#faf8f3');
};
paintTheme();
themeBtn?.addEventListener('click', () => {
  const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
  document.documentElement.dataset.theme = next;
  try{ localStorage.setItem('theme', next); }catch(e){}
  paintTheme();
});

// 3. Signature Tactile Vernier Scale Dial (Hero)
const scaleData = [
  {
    code: 'SCALE 01 // 10⁻⁹ m · MOLECULAR',
    metric: '450 nm ↔ 610 nm',
    titleZh: 'VIE 双发射荧光分子合成（贺晓鹏课题组）',
    titleEn: 'VIE Dual-Emission Fluorophores (Prof. X. He Lab)',
    descZh: '校创新人才培养计划在研，聚焦二氢二苯并吩嗪体系的湿法有机合成与构象双发射光谱调控。',
    descEn: 'Synthesizing dihydrodibenzo[a,c]phenazine fluorophores and tuning bent-to-planar dual emission.',
    jumpZh: '跳转至紫外暗室光谱调谐仪 →',
    jumpEn: 'Jump to UV Spectrum Tuner →',
    href: '#vieLab'
  },
  {
    code: 'SCALE 02 // SCIENTIFIC TOKENS',
    metric: '48 PDFs → 288 RECORDS',
    titleZh: '催化文献智能数据引擎（SAF）',
    titleEn: 'Catalysis Literature Intelligence Engine (SAF)',
    descZh: '从 48 份催化转化 PDF 中提取字段级原文证据，经沸石骨架与化学规则校验产出 288 条可回溯记录。',
    descEn: 'Extracting field-level evidence across 48 PDFs with chemical validation, yielding 288 auditable records.',
    jumpZh: '跳转至催化 X-Ray 透视台 →',
    jumpEn: 'Jump to Evidence X-Ray Inspector →',
    href: '#xrayInspector'
  },
  {
    code: 'SCALE 03 // 10⁵ m · PIPELINE',
    metric: 'MAJOR RANK 01 / 91',
    titleZh: '油气储运工程 · 专业综合排名第一',
    titleEn: 'Oil & Gas Storage and Transportation · Rank 1 / 91',
    descZh: '累计 GPA 3.672（近期加权均分 91.6），物理化学 95、天然气加工 95、石油流变学 92、电工学 99。',
    descEn: 'Cumulative GPA 3.672 (Spring weighted avg 91.6): Natural Gas Processing 95, Phys. Chem 95, Rheology 92.',
    jumpZh: '查看完整学术成绩总账 →',
    jumpEn: 'Inspect Academic Spec Ledger →',
    href: '#academics'
  }
];

let curScaleIdx = 1;
const vernierBtns = [...document.querySelectorAll('.vernier-btn')];
const scaleSvgs = [...document.querySelectorAll('.scale-svg')];
const vernierRuler = document.getElementById('vernierRuler');
const TICK_COUNT = 49;

if(vernierRuler){
  let ticksHtml = '';
  for(let i=0;i<TICK_COUNT;i++){
    const major = i===0 || i===24 || i===48 || i%8===0;
    ticksHtml += `<span class="v-tick${major?' major':''}" data-tick="${i}"></span>`;
  }
  vernierRuler.innerHTML = ticksHtml;
}
const vTicks = [...document.querySelectorAll('.v-tick')];

const paintScale = (idx) => {
  curScaleIdx = idx;
  const item = scaleData[idx];
  if(!item) return;
  const isEn = document.documentElement.dataset.lang === 'en';
  vernierBtns.forEach((b,i)=>{
    b.classList.toggle('active', i===idx);
    b.setAttribute('aria-selected', String(i===idx));
  });
  scaleSvgs.forEach((s,i)=>s.classList.toggle('active', i===idx));
  const codeEl = document.getElementById('scaleModeCode');
  const metEl = document.getElementById('scaleModeMetric');
  const titEl = document.getElementById('scaleTitle');
  const dscEl = document.getElementById('scaleDesc');
  const jmpEl = document.getElementById('scaleJump');
  if(codeEl) codeEl.textContent = item.code;
  if(metEl) metEl.textContent = item.metric;
  if(titEl) titEl.textContent = isEn ? item.titleEn : item.titleZh;
  if(dscEl) dscEl.textContent = isEn ? item.descEn : item.descZh;
  if(jmpEl){ jmpEl.textContent = isEn ? item.jumpEn : item.jumpZh; jmpEl.setAttribute('href', item.href); }

  const zoneStart = idx * 16;
  const zoneEnd = zoneStart + 16;
  vTicks.forEach((t,i)=>t.classList.toggle('active-zone', i>=zoneStart && i<=zoneEnd));
};
paintScale(1);

vernierBtns.forEach(btn=>{
  btn.addEventListener('click', ()=>paintScale(Number(btn.dataset.scale||0)));
});

if(vernierRuler && isFinePointer && !reduceMotion){
  vernierRuler.addEventListener('pointermove', e=>{
    const rect = vernierRuler.getBoundingClientRect();
    const ratio = Math.min(Math.max((e.clientX - rect.left)/rect.width, 0), 1);
    const centerIdx = ratio * (TICK_COUNT - 1);
    vTicks.forEach((t,i)=>{
      const dist = Math.abs(i - centerIdx);
      const lift = dist < 6 ? 1 + (1 - dist/6)*1.15 : 1;
      t.style.transform = `scaleY(${lift.toFixed(2)})`;
    });
  });
  vernierRuler.addEventListener('pointerleave', ()=>{
