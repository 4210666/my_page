<script is:inline>
// Date
const d = new Date();
document.getElementById('today-date').textContent = d.toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'});

const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const introOn=document.documentElement.classList.contains('intro-on');
const finishIntro=()=>{
  document.documentElement.classList.remove('intro-on');
  try{sessionStorage.setItem('introSeen','1');}catch(e){}
  document.body.classList.add('page-ready');
};
if(introOn){
  const introEl=document.getElementById('intro');
  let done=false;
  const end=()=>{if(done)return;done=true;finishIntro();};
  setTimeout(end,2300);
  introEl?.addEventListener('click',end);
  window.addEventListener('keydown',end,{once:true});
}else{
  requestAnimationFrame(()=>document.body.classList.add('page-ready'));
}

// Theme toggle
const themeBtn=document.getElementById('themeToggle');
const metaTheme=document.querySelector('meta[name="theme-color"]');
const paintTheme=()=>{
  const dark=document.documentElement.dataset.theme==='dark';
  if(themeBtn)themeBtn.textContent=dark?'☀':'☾';
  if(metaTheme)metaTheme.setAttribute('content',dark?'#141210':'#faf8f3');
};
paintTheme();
themeBtn?.addEventListener('click',()=>{
  const next=document.documentElement.dataset.theme==='dark'?'light':'dark';
  document.documentElement.dataset.theme=next;
  try{localStorage.setItem('theme',next);}catch(e){}
  paintTheme();
});

// Keep scroll-linked work in a single animation frame.
let scrollTick=false;
const ambientEl=document.querySelector('.ambient-canvas');
const updateScrollMotion=()=>{
  const maxScroll=document.documentElement.scrollHeight-window.innerHeight;
  const p=maxScroll>0?(window.scrollY/maxScroll)*100:0;
  document.getElementById('scrollLine').style.width=p+'%';
  document.querySelector('nav').classList.toggle('scrolled',window.scrollY>24);
  if(ambientEl){
    const fade=Math.min(window.scrollY/(window.innerHeight*0.85),1);
    ambientEl.style.setProperty('--ambient-op',(0.96-fade*0.58).toFixed(2));
  }
  if(!reduceMotion){
    const portrait=document.querySelector('.portrait img');
    if(portrait&&window.scrollY<window.innerHeight*1.15){
      portrait.style.transform=`translate3d(0,${Math.min(window.scrollY*.035,18)}px,0) scale(1.025)`;
    }
  }
  scrollTick=false;
};
window.addEventListener('scroll',()=>{
  if(!scrollTick){scrollTick=true;requestAnimationFrame(updateScrollMotion);}
},{passive:true});
updateScrollMotion();

const revealSelectors=[
  '.about-text','.timeline-item','.acad-card','.research-box','.semester-stat',
  '.course-group-title','.course-item','.skill-card','.activity-card',
  '.certs-intro','.cert-item','.contact-layout>div','.aside-box'
].join(',');
document.querySelectorAll('section').forEach(section=>{
  section.querySelectorAll(revealSelectors).forEach((el,index)=>{
    el.classList.add('motion-reveal');
    el.style.setProperty('--reveal-delay',`${Math.min(index%8,7)*65}ms`);
  });
});

// Section reveal
const obs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.classList.add('visible');
      obs.unobserve(e.target);
    }
  });
},{threshold:0.08,rootMargin:'0px 0px -5% 0px'});
document.querySelectorAll('section').forEach(s=>obs.observe(s));

// Highlight the chapter currently in view.
const navItems=[...document.querySelectorAll('.nav-links a')];
const navObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      navItems.forEach(link=>link.classList.toggle('active',link.getAttribute('href')===`#${e.target.id}`));
      const sceneMap={about:'pipe',academics:'lab',skills:'lab',certs:'lab',projects:'data',activities:'pipe',contact:'pipe'};
      document.body.dataset.scene=sceneMap[e.target.id]||'pipe';
    }
  });
},{rootMargin:'-25% 0px -60% 0px',threshold:0});
document.querySelectorAll('section[id]').forEach(section=>navObs.observe(section));

// Count important numbers once when they enter the viewport.
const countObs=new IntersectionObserver(entries=>{
  entries.forEach(entry=>{
    if(!entry.isIntersecting)return;
    const el=entry.target;
    const textNode=[...el.childNodes].find(node=>node.nodeType===Node.TEXT_NODE&&/\d/.test(node.textContent));
    if(!textNode){countObs.unobserve(el);return;}
    const raw=textNode.textContent.trim();
    const target=Number.parseFloat(raw);
    if(!Number.isFinite(target)||reduceMotion){countObs.unobserve(el);return;}
    const decimals=(raw.split('.')[1]||'').length;
    const start=performance.now();
    const duration=950;
    const step=now=>{
      const progress=Math.min((now-start)/duration,1);
      const eased=1-Math.pow(1-progress,3);
      textNode.textContent=(target*eased).toFixed(decimals);
      if(progress<1)requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
    countObs.unobserve(el);
  });
},{threshold:.55});
document.querySelectorAll('.stat-num,.acad-big,.semester-value,.course-score').forEach(el=>countObs.observe(el));

// Pointer-aware cards: restrained tilt plus a local editorial-red glow.
const finePointer=window.matchMedia('(hover:hover) and (pointer:fine)').matches;
const motionCards=document.querySelectorAll('.acad-card,.semester-stat,.course-item,.skill-card,.activity-card,.cert-item,.aside-box,.research-box');
const jItems=[...document.querySelectorAll('.journey-item')];
const journeyList=document.querySelector('.journey-list');
const updateJourney=()=>{
  if(!journeyList)return;
  const rect=journeyList.getBoundingClientRect();
  const mid=window.innerHeight*0.62;
  const progress=Math.min(Math.max((mid-rect.top)/rect.height,0),1);
  journeyList.style.setProperty('--jp',(progress*100).toFixed(1)+'%');
  jItems.forEach(it=>{const r=it.getBoundingClientRect();it.classList.toggle('on',r.top<mid);});
};
window.addEventListener('scroll',updateJourney,{passive:true});
updateJourney();

// Gauges
const gaugeObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(!e.isIntersecting)return;
    e.target.querySelectorAll('.gauge').forEach(g=>{
      const fill=parseFloat(g.dataset.fill||'0');
      g.querySelector('.g-arc').style.strokeDashoffset=String(100-fill);
    });
    gaugeObs.unobserve(e.target);
  });
},{threshold:.3});
const acadGrid=document.querySelector('.academics-grid');
if(acadGrid)gaugeObs.observe(acadGrid);

// Quick mail -> mailto
document.getElementById('quickMail')?.addEventListener('submit',ev=>{
  ev.preventDefault();
  const f=ev.target;
  const role=f.role.value,who=f.who.value.trim(),msg=f.msg.value.trim();
  const subject=encodeURIComponent('来自个人主页的留言'+(who?'｜'+who:''));
  const body=encodeURIComponent('身份：'+role+'\n称呼：'+(who||'—')+'\n\n'+msg+'\n\n— 来自 zts666.me');
  location.href='mailto:24010663@mail.ecust.edu.cn?subject='+subject+'&body='+body;
});
motionCards.forEach(card=>{
  card.classList.add('motion-card');
  if(!finePointer||reduceMotion)return;
  card.addEventListener('pointermove',event=>{
    const rect=card.getBoundingClientRect();
    const x=event.clientX-rect.left;
    const y=event.clientY-rect.top;
    const rx=((y/rect.height)-.5)*-2.2;
    const ry=((x/rect.width)-.5)*2.2;
    card.style.setProperty('--mx',`${x}px`);
    card.style.setProperty('--my',`${y}px`);
    card.style.transform=`perspective(850px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-2px)`;
  });
  card.addEventListener('pointerleave',()=>{card.style.transform='';});
});

// Skill bars
const barObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.querySelectorAll('.skill-bar-fill').forEach(b=>{b.style.width=b.dataset.width+'%';});
