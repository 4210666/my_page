  });
};
if(document.documentElement.dataset.lang==='en')applyLang('en');
langBtn?.addEventListener('click',()=>{
  const next=document.documentElement.dataset.lang==='en'?'zh':'en';
  try{localStorage.setItem('lang',next);}catch(e){}
  applyLang(next);
});

</script>
</body>
</html>
