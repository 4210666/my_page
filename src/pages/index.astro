// 5. Interactive VIE Dual-Emission Spectrum Tuner (Inside #projects Darkroom)
const vieSlider = document.getElementById('vieSlider');
const vieCurveBlue = document.getElementById('vieCurveBlue');
const vieCurveRed = document.getElementById('vieCurveRed');
const vieAreaBlue = document.getElementById('vieAreaBlue');
const vieAreaRed = document.getElementById('vieAreaRed');
const viePctVal = document.getElementById('viePctVal');
const vieRatioVal = document.getElementById('vieRatioVal');
const vieTunerEl = document.getElementById('vieTuner');
const viePresets = [...document.querySelectorAll('.vie-preset')];

const buildGaussian = (mu, sigma, amp) => {
  const pts = [];
  for(let x=26; x<=500; x+=8){
    const g = Math.exp(-0.5 * Math.pow((x - mu)/sigma, 2));
    pts.push(`${x},${(102 - amp * g).toFixed(1)}`);
  }
  const line = 'M' + pts.join(' L');
  return { line, area: line + ' L500,102 L26,102 Z' };
};

const updateVieSpectrum = (val) => {
  const p = Math.min(Math.max(Number(val)/100, 0), 1);
  const ampBlue = 16 + (1 - p) * 68;
  const ampRed = 14 + p * 70;
  const bPath = buildGaussian(145, 38, ampBlue);
  const rPath = buildGaussian(355, 46, ampRed);
  if(vieCurveBlue) vieCurveBlue.setAttribute('d', bPath.line);
  if(vieAreaBlue) vieAreaBlue.setAttribute('d', bPath.area);
  if(vieCurveRed) vieCurveRed.setAttribute('d', rPath.line);
  if(vieAreaRed) vieAreaRed.setAttribute('d', rPath.area);
  if(viePctVal) viePctVal.textContent = Math.round(p * 100) + '%';
  if(vieRatioVal) vieRatioVal.textContent = (ampRed / ampBlue).toFixed(2);
  const r = Math.round(p<0.5 ? 60+(235-60)*(p*2) : 235+(240-235)*((p-0.5)*2));
  const g = Math.round(p<0.5 ? 235+(175-235)*(p*2) : 175+(120-175)*((p-0.5)*2));
  const b = Math.round(p<0.5 ? 190+(220-190)*(p*2) : 220+(80-220)*((p-0.5)*2));
  vieTunerEl?.style.setProperty('--vie-color', `rgb(${r},${g},${b})`);
  viePresets.forEach(btn=>btn.classList.toggle('active', Math.abs(Number(btn.dataset.vie) - p*100) < 12));
};
if(vieSlider){
  updateVieSpectrum(vieSlider.value);
  vieSlider.addEventListener('input', e=>updateVieSpectrum(e.target.value));
  viePresets.forEach(btn=>btn.addEventListener('click', ()=>{
    vieSlider.value = btn.dataset.vie;
    updateVieSpectrum(btn.dataset.vie);
  }));
}

