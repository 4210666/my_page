}
@media(prefers-reduced-motion:reduce){.visit-counter::before{animation:none;}}

.course-block{border:0.5px solid var(--line);padding:1.5rem;margin-top:1.5rem;background:var(--bg2);}
.semester-overview{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:0;border:0.5px solid var(--line);margin-top:1rem;background:var(--bg);}
.semester-stat{padding:1.15rem 1rem;border-right:0.5px solid var(--line);}
.semester-stat:last-child{border-right:none;}
.semester-value{font-family:var(--serif);font-size:28px;font-weight:900;color:var(--ink);line-height:1;margin-bottom:6px;}
.semester-value em{font-size:12px;font-style:normal;font-weight:500;color:var(--accent);margin-left:4px;}
.semester-label{font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:var(--ink3);}
.semester-caption{font-size:10px;color:var(--ink2);margin-top:5px;line-height:1.5;}
.course-group-title{display:flex;align-items:center;gap:0.8rem;margin-top:1.25rem;font-size:9px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink3);}
.course-group-title::after{content:"";height:0.5px;background:var(--line);flex:1;}
.course-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:1rem;border:0.5px solid var(--line);}
.course-item{padding:1rem 0.8rem;border-right:0.5px solid var(--line);border-bottom:0.5px solid var(--line);transition:background 0.2s;}
.course-item:hover{background:var(--bg3);}
.course-item:nth-child(4n){border-right:none;}
.course-item:nth-last-child(-n+4){border-bottom:none;}
.course-item.highlight .course-score{color:var(--accent);}
.course-score{font-family:var(--serif);font-size:26px;font-weight:900;line-height:1;margin-bottom:4px;color:var(--ink);}
.course-name{font-size:11px;font-weight:500;color:var(--ink);margin-bottom:3px;line-height:1.4;}
.course-meta{font-size:9px;color:var(--ink3);letter-spacing:0.06em;margin-bottom:8px;}
.course-bar{height:2px;background:var(--bg3);position:relative;overflow:hidden;}
.course-bar-fill{position:absolute;left:0;top:0;bottom:0;background:var(--ink);width:0;transition:width 1.4s cubic-bezier(0.4,0,0.2,1);}
.course-item.highlight .course-bar-fill{background:var(--accent);}
.course-more{display:none;}
.course-more.expanded{display:block;}
.course-toggle-btn{margin-top:1rem;width:100%;padding:9px 14px;background:var(--bg);border:0.5px solid var(--line);font-family:var(--mono);font-size:10px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink2);cursor:pointer;transition:all 0.2s;}
.course-toggle-btn:hover{border-color:var(--accent);color:var(--accent);}
.course-note{font-size:11px;color:var(--ink3);margin-top:1rem;padding-top:0.8rem;border-top:0.5px solid var(--line);letter-spacing:0.03em;}
@media(max-width:700px){.semester-overview{grid-template-columns:1fr;}.semester-stat{border-right:none;border-bottom:0.5px solid var(--line);}.semester-stat:last-child{border-bottom:none;}.course-grid{grid-template-columns:repeat(2,1fr);}.course-item:nth-child(4n){border-right:0.5px solid var(--line);}.course-item:nth-child(2n){border-right:none;}.course-item:nth-last-child(-n+4){border-bottom:0.5px solid var(--line);}.course-item:nth-last-child(-n+2){border-bottom:none;}}

/* MOTION SYSTEM */
body{isolation:isolate;}
.ambient-canvas{position:fixed;inset:-12vh -10vw;z-index:0;pointer-events:none;overflow:hidden;opacity:var(--ambient-op,.96);transition:opacity .25s ease;}
.ambient-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(26,25,22,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(26,25,22,.06) 1px,transparent 1px);background-size:72px 72px;mask-image:radial-gradient(ellipse at center,#000 8%,rgba(0,0,0,.78) 52%,transparent 90%);animation:gridDrift 26s linear infinite;will-change:background-position;}
.ambient-orb{position:absolute;border-radius:50%;filter:blur(2px);will-change:transform;}
.ambient-orb.a{width:42vw;height:42vw;left:-10vw;top:8vh;background:radial-gradient(circle,rgba(184,92,56,.17),rgba(184,92,56,0) 68%);animation:ambientA 18s ease-in-out infinite alternate;}
.ambient-orb.b{width:48vw;height:48vw;right:-14vw;top:38vh;background:radial-gradient(circle,rgba(139,58,42,.13),rgba(139,58,42,0) 70%);animation:ambientB 24s ease-in-out infinite alternate;}
.ambient-orb.c{width:34vw;height:34vw;left:34vw;bottom:-16vw;background:radial-gradient(circle,rgba(90,105,94,.13),rgba(90,105,94,0) 70%);animation:ambientC 21s ease-in-out infinite alternate;}
@keyframes gridDrift{to{background-position:72px 72px;}}
@keyframes ambientA{to{transform:translate3d(8vw,10vh,0) scale(1.14);}}
@keyframes ambientB{to{transform:translate3d(-12vw,-8vh,0) scale(.9);}}
@keyframes ambientC{to{transform:translate3d(5vw,-13vh,0) scale(1.18);}}
.ambient-molecule{position:absolute;width:clamp(250px,27vw,420px);height:auto;overflow:visible;opacity:.47;filter:drop-shadow(0 12px 30px rgba(139,58,42,.09));will-change:transform;}
.ambient-molecule path,.ambient-molecule line{fill:none;stroke:rgba(139,58,42,.62);stroke-width:1.25;stroke-dasharray:5 11;animation:dashFlow 14s linear infinite;}
.ambient-molecule circle{fill:rgba(250,248,243,.9);stroke:rgba(139,58,42,.7);stroke-width:1.35;transform-box:fill-box;transform-origin:center;animation:nodePulse 4.8s ease-in-out infinite;}
.ambient-molecule circle:nth-of-type(2n){animation-delay:-1.6s;}
.ambient-molecule circle:nth-of-type(3n){animation-delay:-3.2s;}
.ambient-molecule.left{left:2vw;top:18vh;animation:moleculeFloatA 16s ease-in-out infinite alternate;}
.ambient-molecule.right{right:1vw;top:54vh;animation:moleculeFloatB 20s ease-in-out infinite alternate-reverse;}
@keyframes dashFlow{to{stroke-dashoffset:-160;}}
@keyframes nodePulse{0%,100%{transform:scale(.82);opacity:.46;}50%{transform:scale(1.28);opacity:1;}}
@keyframes moleculeFloatA{to{transform:translate3d(2.4vw,5vh,0) rotate(7deg);}}
@keyframes moleculeFloatB{to{transform:translate3d(-3vw,-6vh,0) rotate(-8deg);}}
.ambient-signal{position:absolute;left:8vw;right:8vw;bottom:9vh;width:84vw;height:120px;overflow:visible;opacity:.3;}
.ambient-signal .signal-base{fill:none;stroke:rgba(26,25,22,.34);stroke-width:1;}
.ambient-signal .signal-live{fill:none;stroke:rgba(184,92,56,.82);stroke-width:1.5;stroke-dasharray:12 20;animation:signalTravel 10s linear infinite;}
@keyframes signalTravel{to{stroke-dashoffset:-320;}}
.ambient-particle{position:absolute;width:6px;height:6px;border:1px solid rgba(139,58,42,.58);box-shadow:0 0 14px rgba(184,92,56,.12);transform:rotate(45deg);animation:particleDrift 12s ease-in-out infinite alternate;}
.ambient-particle.p1{left:24%;top:24%;animation-delay:-3s;}
.ambient-particle.p2{right:29%;top:36%;animation-delay:-7s;}
.ambient-particle.p3{left:47%;bottom:20%;animation-delay:-10s;}
@keyframes particleDrift{0%{opacity:.2;transform:translateY(0) rotate(45deg) scale(.7);}50%{opacity:.9;}100%{opacity:.25;transform:translateY(-55px) rotate(225deg) scale(1.4);}}
.pipeline-frame{position:absolute;inset:12vh 10vw;width:calc(100% - 20vw);height:calc(100% - 24vh);overflow:visible;opacity:.46;}
.pipe-shell{fill:none;stroke:rgba(26,25,22,.24);stroke-width:2.2;vector-effect:non-scaling-stroke;}
.pipe-highlight{fill:none;stroke:rgba(139,58,42,.54);stroke-width:1.15;stroke-dasharray:7 15;vector-effect:non-scaling-stroke;animation:pipelineFlow 11s linear infinite;}
.pipe-joint{fill:rgba(250,248,243,.92);stroke:rgba(139,58,42,.55);stroke-width:1.4;vector-effect:non-scaling-stroke;}
.pipe-joint.live{animation:pipePressure 3.8s ease-in-out infinite;transform-box:fill-box;transform-origin:center;}
.pipe-valve{transform-box:fill-box;transform-origin:center;animation:valveTurn 9s ease-in-out infinite;}
.pipe-valve circle{fill:rgba(250,248,243,.94);stroke:rgba(26,25,22,.34);stroke-width:1.4;vector-effect:non-scaling-stroke;}
.pipe-valve path{fill:none;stroke:rgba(139,58,42,.66);stroke-width:1.5;vector-effect:non-scaling-stroke;}
.pipe-label{fill:rgba(139,58,42,.58);font-family:var(--mono);font-size:12px;letter-spacing:4px;}
.pipe-reading{fill:rgba(26,25,22,.42);font-family:var(--mono);font-size:10px;letter-spacing:2px;}
.pipeline-beacon{fill:var(--accent2);opacity:.75;filter:drop-shadow(0 0 5px rgba(184,92,56,.5));animation:beaconPulse 2.6s ease-in-out infinite;}
.pipeline-beacon.alt{animation-delay:-1.3s;}
.pid-equipment{fill:rgba(250,248,243,.58);stroke:rgba(26,25,22,.33);stroke-width:1.4;vector-effect:non-scaling-stroke;}
.pid-equipment-detail{fill:none;stroke:rgba(139,58,42,.52);stroke-width:1.15;vector-effect:non-scaling-stroke;}
.pid-signal{fill:none;stroke:rgba(139,58,42,.45);stroke-width:1;stroke-dasharray:3 7;vector-effect:non-scaling-stroke;animation:pidSignal 7s linear infinite;}
.pid-instrument{fill:rgba(250,248,243,.94);stroke:rgba(139,58,42,.62);stroke-width:1.25;vector-effect:non-scaling-stroke;}
.pid-instrument-text{fill:rgba(26,25,22,.63);font-family:var(--mono);font-size:10px;font-weight:500;text-anchor:middle;}
.pid-tag{fill:rgba(26,25,22,.58);font-family:var(--mono);font-size:11px;letter-spacing:1.5px;}
.pid-param{fill:rgba(139,58,42,.66);font-family:var(--mono);font-size:9px;letter-spacing:1.2px;}
.pid-stream{fill:rgba(139,58,42,.68);}
.pid-control-valve{fill:rgba(250,248,243,.9);stroke:rgba(139,58,42,.62);stroke-width:1.25;vector-effect:non-scaling-stroke;animation:controlValve 5.5s ease-in-out infinite;transform-box:fill-box;transform-origin:center;}
.pid-flow-dot{fill:var(--accent2);opacity:.84;filter:drop-shadow(0 0 4px rgba(184,92,56,.5));}
@keyframes pipelineFlow{to{stroke-dashoffset:-220;}}
@keyframes pidSignal{to{stroke-dashoffset:-70;}}
@keyframes pipePressure{0%,100%{opacity:.4;transform:scale(.78);}50%{opacity:1;transform:scale(1.25);}}
@keyframes valveTurn{0%,35%,100%{transform:rotate(0deg);}55%,80%{transform:rotate(22deg);}}
@keyframes controlValve{0%,100%{transform:scale(.94);opacity:.68;}50%{transform:scale(1.08);opacity:1;}}
@keyframes beaconPulse{0%,100%{opacity:.22;}50%{opacity:.95;}}
nav,#hero,section,.ornament,footer{position:relative;z-index:1;}

nav{transition:height .35s ease,box-shadow .35s ease,background .35s ease;}
nav.scrolled{background:var(--nav-bg2);box-shadow:0 12px 35px rgba(26,25,22,.06);}
.nav-links a{position:relative;}
.nav-links a::after{content:"";position:absolute;left:0;right:100%;bottom:-7px;height:1px;background:var(--accent);transition:right .35s cubic-bezier(.2,.8,.2,1);}
.nav-links a:hover::after,.nav-links a.active::after{right:0;}
.nav-links a.active{color:var(--accent);}

.hero-inner{animation:none;}
.masthead-top,.kicker,.headline,.hero-body,.hero-cta,.portrait,.stat-row{opacity:0;will-change:transform,opacity;}
.page-ready .masthead-top{animation:editorialIn .7s .08s both;}
.page-ready .kicker{animation:editorialIn .65s .2s both;}
.page-ready .headline{animation:headlineIn .95s .28s cubic-bezier(.16,1,.3,1) both;}
.page-ready .hero-body{animation:editorialIn .8s .48s both;}
.page-ready .hero-cta{animation:editorialIn .75s .62s both;}
.page-ready .portrait{animation:portraitIn 1.05s .28s cubic-bezier(.16,1,.3,1) both;}
.page-ready .stat-row{animation:editorialIn .8s .58s both;}
@keyframes editorialIn{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}
@keyframes headlineIn{from{opacity:0;transform:translateY(34px);clip-path:inset(0 0 100% 0);}to{opacity:1;transform:none;clip-path:inset(0);}}
@keyframes portraitIn{from{opacity:0;transform:translateY(28px) scale(.96);clip-path:inset(8% 8% 8% 8%);}to{opacity:1;transform:none;clip-path:inset(0);}}
.portrait::after{content:"";position:absolute;inset:-40% -75%;background:linear-gradient(105deg,transparent 42%,rgba(255,255,255,.24) 50%,transparent 58%);transform:translateX(-45%) rotate(6deg);animation:portraitSweep 8s 1.6s ease-in-out infinite;}
@keyframes portraitSweep{0%,70%{transform:translateX(-45%) rotate(6deg);}90%,100%{transform:translateX(45%) rotate(6deg);}}
.portrait img{will-change:transform;transition:transform .2s linear;}

section{opacity:1;transform:none;transition:none;}
section .section-header{opacity:0;transform:translateY(18px);transition:opacity .65s ease,transform .65s cubic-bezier(.2,.8,.2,1);}
section.visible .section-header{opacity:1;transform:none;}
.section-rule{transform:scaleX(0);transform-origin:left;transition:transform 1s .18s cubic-bezier(.16,1,.3,1);}
section.visible .section-rule{transform:scaleX(1);}
.motion-reveal{opacity:0;transform:translateY(24px);transition:opacity .65s ease,transform .75s cubic-bezier(.16,1,.3,1);transition-delay:var(--reveal-delay,0ms);}
section.visible .motion-reveal{opacity:1;transform:none;}

.motion-card{--mx:50%;--my:50%;position:relative;isolation:isolate;transition:transform .32s cubic-bezier(.2,.8,.2,1),box-shadow .32s ease,background .25s ease;transform-style:preserve-3d;}
.motion-card::after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:0;background:radial-gradient(220px circle at var(--mx) var(--my),rgba(184,92,56,.16),transparent 68%);transition:opacity .3s ease;}
.motion-card:hover{box-shadow:0 18px 42px rgba(45,34,27,.09);}
.motion-card:hover::after{opacity:1;}
.acad-card.motion-card::after,.semester-stat.motion-card::after{z-index:0;}
.acad-card.motion-card>*,.semester-stat.motion-card>*{position:relative;z-index:1;}

.stat-num,.acad-big,.semester-value,.course-score{font-variant-numeric:tabular-nums;}
.status-dot{animation:statusPulse 2.4s ease-out infinite;box-shadow:0 0 0 0 rgba(58,122,90,.28);}
@keyframes statusPulse{60%,100%{box-shadow:0 0 0 9px rgba(58,122,90,0);}}
.lightbox{display:flex;opacity:0;visibility:hidden;transition:opacity .3s ease,visibility .3s ease;}
.lightbox.open{display:flex;opacity:1;visibility:visible;}
.lightbox img{transform:scale(.96);transition:transform .45s cubic-bezier(.16,1,.3,1);}
.lightbox.open img{transform:scale(1);}

@media(max-width:700px){
  .ambient-canvas{opacity:.7;}
  .ambient-grid{background-size:48px 48px;animation-name:gridDriftMobile;}
  @keyframes gridDriftMobile{to{background-position:48px 48px;}}
  .ambient-orb.a{width:95vw;height:95vw;}
  .ambient-orb.b{width:110vw;height:110vw;}
  .ambient-molecule{width:195px;opacity:.29;}
  .ambient-molecule.left{left:-80px;top:25vh;}
  .ambient-molecule.right{right:-90px;top:67vh;}
  .ambient-signal{left:-10vw;width:120vw;opacity:.18;}
  .pipeline-frame{inset:12vh 10vw;width:calc(100% - 20vw);height:calc(100% - 24vh);opacity:.28;}
  .pipeline-frame .desktop-pipe,.pipeline-frame .pipe-label,.pipeline-frame .pipe-reading,.pipeline-frame .pid-detail{display:none;}
  .pipe-shell{stroke-width:1.5;}
  .motion-card:hover{box-shadow:none;}
}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto;}
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;}
  .masthead-top,.kicker,.headline,.hero-body,.hero-cta,.portrait,.stat-row,.motion-reveal,section .section-header{opacity:1!important;transform:none!important;clip-path:none!important;}
}

/* ═════ EXTENSIONS ═════ */
.nav-tools{display:flex;align-items:center;gap:8px;margin-left:auto;margin-right:1.2rem;}
.tool-btn{background:transparent;border:0.5px solid var(--line);color:var(--ink2);font-family:var(--mono);font-size:11px;letter-spacing:0.08em;min-width:34px;height:28px;padding:0 8px;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;justify-content:center;}
.tool-btn:hover{border-color:var(--accent);color:var(--accent);}
@media(max-width:960px){.nav-links{gap:1rem;}}
@media(max-width:700px){.nav-tools{margin-right:.5rem;}}

/* Intro overlay */
.intro{display:none;}
html.intro-on .intro{display:flex;position:fixed;inset:0;z-index:10000;background:var(--bg);align-items:center;justify-content:center;flex-direction:column;cursor:pointer;animation:introOut .7s 1.9s ease forwards;}
html.intro-on body{overflow:hidden;}
.intro-line{position:absolute;left:0;right:0;top:50%;height:1px;background:linear-gradient(90deg,transparent,var(--accent),transparent);transform:scaleX(0);animation:introLine 1s .1s cubic-bezier(.16,1,.3,1) forwards;opacity:.55;}
.intro-dot{position:absolute;width:7px;height:7px;border-radius:50%;background:var(--accent2);box-shadow:0 0 14px rgba(184,92,56,.55);left:var(--x);top:var(--y);opacity:0;animation:introDot .95s var(--d) cubic-bezier(.65,0,.25,1) forwards;}
.intro-name{position:relative;font-family:var(--serif);font-size:clamp(44px,9vw,92px);font-weight:900;color:var(--ink);letter-spacing:.5em;opacity:0;animation:introName 1s .85s cubic-bezier(.16,1,.3,1) forwards;}
.intro-sub{position:relative;margin-top:.8rem;font-family:var(--mono);font-size:11px;letter-spacing:.3em;color:var(--accent);text-transform:uppercase;opacity:0;animation:introSub .8s 1.25s ease forwards;}
@keyframes introLine{to{transform:scaleX(1);}}
@keyframes introDot{0%{opacity:0;}20%{opacity:1;}100%{left:50%;top:50%;opacity:0;transform:scale(.3);}}
@keyframes introName{from{opacity:0;letter-spacing:.5em;filter:blur(8px);}to{opacity:1;letter-spacing:.04em;filter:blur(0);}}
@keyframes introSub{from{opacity:0;transform:translateY(8px);}to{opacity:.9;transform:none;}}
@keyframes introOut{to{opacity:0;visibility:hidden;}}

/* Journey timeline */
.journey{margin-top:3.5rem;padding-top:1.6rem;border-top:0.5px solid var(--line);}
.journey-title{font-family:var(--mono);font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:var(--ink3);margin-bottom:1.4rem;}
.journey-list{list-style:none;position:relative;margin-left:6px;padding-left:2rem;}
.journey-list::before{content:"";position:absolute;left:0;top:6px;bottom:6px;width:1px;background:var(--line);}
.journey-list::after{content:"";position:absolute;left:0;top:6px;width:1px;height:var(--jp,0%);background:var(--accent);transition:height .3s linear;max-height:calc(100% - 12px);}
.journey-item{position:relative;display:grid;grid-template-columns:120px 1fr;gap:1.2rem;padding:0 0 1.7rem;}
.journey-item:last-child{padding-bottom:0;}
.journey-item::before{content:"";position:absolute;left:calc(-2rem - 4px);top:7px;width:9px;height:9px;border-radius:50%;background:var(--bg);border:1.5px solid var(--ink3);transition:all .4s;}
.journey-item.on::before{background:var(--accent);border-color:var(--accent);box-shadow:0 0 0 5px rgba(139,58,42,.14);}
.j-time{font-family:var(--mono);font-size:12px;color:var(--accent);letter-spacing:.04em;padding-top:2px;}
.j-body strong{display:block;font-family:var(--serif);font-size:16px;color:var(--ink);margin-bottom:3px;}
.j-body p{font-size:13.5px;line-height:1.8;color:var(--ink2);}
@media(max-width:700px){.journey-item{grid-template-columns:1fr;gap:.2rem;}}

/* Gauges */
.gauge{display:block;margin:0 auto 8px;width:92px;height:52px;overflow:visible;}
.gauge .g-track,.gauge .g-arc{fill:none;stroke-width:4;stroke-linecap:round;}
.gauge .g-track{stroke:var(--line);}
.gauge .g-arc{stroke:var(--accent);stroke-dasharray:100;stroke-dashoffset:100;transition:stroke-dashoffset 1.6s cubic-bezier(.16,1,.3,1);}
.gauge .g-tick{stroke:var(--ink3);stroke-width:1;opacity:.5;}
.medal{display:block;text-align:center;font-size:16px;letter-spacing:6px;color:var(--accent);height:52px;line-height:44px;}

/* Fluorescence (VIE) hover glow */
.vie-glow{position:relative;overflow:hidden;}
.vie-glow::before{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .35s ease;z-index:0;
  background:radial-gradient(280px circle at var(--mx,50%) var(--my,50%),rgba(60,235,190,.26),rgba(60,235,190,.09) 45%,transparent 72%);}
.vie-glow:hover::before{opacity:1;}
.vie-glow .research-item-title em,.vie-glow .skill-name{transition:color .3s,text-shadow .3s;}
.vie-glow:hover .research-item-title em,.vie-glow:hover .skill-name{color:#12b898;text-shadow:0 0 14px rgba(40,235,190,.6);}

/* Folder-style certificate wall */
.cert-img-wrap{position:relative;}
.cert-img-wrap::after{content:"";position:absolute;left:0;right:0;bottom:0;height:26%;background:var(--bg2);border-top:1px solid var(--line);
  clip-path:polygon(0 22%,24% 22%,30% 0,100% 0,100% 100%,0 100%);transition:transform .45s cubic-bezier(.16,1,.3,1);z-index:2;}
.cert-img-wrap img{transition:transform .45s cubic-bezier(.16,1,.3,1);}
.cert-item:hover .cert-img-wrap::after{transform:translateY(105%);}
.cert-item:hover .cert-img-wrap img{transform:translateY(-3%) scale(1.04);}
@media(hover:none){.cert-img-wrap::after{display:none;}}

/* Contact additions */
.contact-actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.4rem;}
.quick-mail{margin-top:1.2rem;border:0.5px solid var(--line);background:var(--card);}
.quick-mail summary{cursor:pointer;padding:.85rem 1rem;font-family:var(--mono);font-size:11px;letter-spacing:.12em;color:var(--ink2);list-style:none;}
.quick-mail summary::-webkit-details-marker{display:none;}
.quick-mail summary::after{content:" +";color:var(--accent);}
.quick-mail[open] summary::after{content:" −";}
.quick-mail form{padding:0 1rem 1rem;display:grid;gap:.7rem;}
.quick-mail label{display:grid;gap:4px;font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--ink3);text-transform:uppercase;}
.quick-mail input,.quick-mail select,.quick-mail textarea{font:inherit;font-family:var(--sans);font-size:14px;letter-spacing:0;text-transform:none;color:var(--ink);background:var(--bg);border:0.5px solid var(--line);padding:8px 10px;width:100%;}
.quick-mail textarea{min-height:90px;resize:vertical;}
.quick-mail input:focus,.quick-mail select:focus,.quick-mail textarea:focus{outline:1px solid var(--accent);border-color:var(--accent);}
.quick-mail .hint{font-size:11px;color:var(--ink3);letter-spacing:0;text-transform:none;}
.qr-row{display:flex;gap:1rem;align-items:center;}
.qr-row img{width:96px;height:96px;background:#fff;padding:5px;border:0.5px solid var(--line);flex:none;}
.qr-row p{font-size:13px;color:var(--ink2);margin-bottom:6px;}
.qr-row a{font-family:var(--mono);font-size:11px;letter-spacing:.1em;color:var(--accent);text-decoration:none;border-bottom:1px solid currentColor;}

/* Scene-aware ambient background */
.ambient-molecule,.pipeline-frame,.ambient-signal{transition:opacity .9s ease;}
body[data-scene="lab"] .ambient-molecule{opacity:.78;}
body[data-scene="lab"] .pipeline-frame{opacity:.16;}
body[data-scene="data"] .ambient-signal{opacity:.75;}
body[data-scene="data"] .ambient-molecule{opacity:.18;}
body[data-scene="data"] .pipeline-frame{opacity:.2;}
body[data-scene="pipe"] .ambient-molecule{opacity:.26;}
@media(max-width:700px){
  body[data-scene="lab"] .ambient-molecule{opacity:.4;}
  body[data-scene="data"] .ambient-signal{opacity:.4;}
}

/* Language swap helper */
html[data-lang="en"] .nav-links a,html[data-lang="en"] .mobile-menu a{letter-spacing:.06em;}

/* Print = clean one-document résumé-like view */
@media print{
  .ambient-canvas,nav,.mobile-menu,.scroll-line,.intro,.lightbox,.copy-toast,.hero-cta,.course-toggle-btn,.quick-mail,.contact-actions,.qr-box,.nav-tools,body::before{display:none!important;}
  body{background:#fff;color:#000;font-size:11pt;}
  html[data-theme="dark"]{--ink:#1a1916;--ink2:#4a4845;--ink3:#7a7874;--bg:#fff;--bg2:#f4f2ec;--bg3:#eae6da;--line:rgba(26,25,22,.2);--accent:#8b3a2a;}
  section,.catalysis-project{opacity:1!important;transform:none!important;padding:1.2rem 0!important;break-inside:avoid-page;}
  .motion-reveal,.section-header,.masthead-top,.kicker,.headline,.hero-body,.portrait,.stat-row{opacity:1!important;transform:none!important;clip-path:none!important;animation:none!important;}
  .course-more{display:block!important;}
  #hero{min-height:auto;padding-top:0;}
  a{color:inherit;text-decoration:none;}
  .showcase-media video{display:none;}
  .showcase-poster{display:block!important;}
  .cert-img-wrap::after{display:none;}
}
@media(prefers-reduced-motion:reduce){
  html.intro-on .intro{display:none;}
  .gauge .g-arc{transition:none;}
}
