let lbIndex=0;
const lbEl=document.getElementById('lightbox');
const lbImg=document.getElementById('lbImg');
const lbCounter=document.getElementById('lbCounter');
const lbTitle=document.getElementById('lbTitle');
const renderLb=()=>{
  const item=certs[lbIndex];
  lbImg.src=item.src;
  lbImg.alt=item.title;
  lbCounter.textContent=`0${lbIndex+1} / 0${certs.length}`;
  lbTitle.textContent=item.title;
};
window.openLb=function openLb(key){
  const idx=certs.findIndex(c=>c.key===key);
  lbIndex=idx>=0?idx:0;
  renderLb();
  lbEl.classList.add('open');
};
const stepLb=dir=>{lbIndex=(lbIndex+dir+certs.length)%certs.length;renderLb();};
document.getElementById('lbPrev').addEventListener('click',e=>{e.stopPropagation();stepLb(-1);});
document.getElementById('lbNext').addEventListener('click',e=>{e.stopPropagation();stepLb(1);});
document.getElementById('lbClose').addEventListener('click',()=>lbEl.classList.remove('open'));
lbEl.addEventListener('click',e=>{if(e.target===lbEl)lbEl.classList.remove('open');});
window.addEventListener('keydown',e=>{
  if(!lbEl.classList.contains('open'))return;
  if(e.key==='Escape')lbEl.classList.remove('open');
  if(e.key==='ArrowLeft')stepLb(-1);
  if(e.key==='ArrowRight')stepLb(1);
});

