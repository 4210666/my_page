<script is:inline>
// Date
const d = new Date();
document.getElementById('today-date').textContent = d.toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'});

const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const introOn=document.documentElement.classList.contains('intro-on');
const finishIntro=()=>{
  document.documentElement.classList.add('intro-closing');
  document.body.classList.add('page-ready');
  setTimeout(()=>{
    document.documentElement.classList.remove('intro-on','intro-closing');
  },880);
};
if(introOn){
  const introEl=document.getElementById('intro');
  const pctEl=document.getElementById('introPct');
  const statusEl=document.getElementById('introStatus');
  let done=false;
  const t0=performance.now();
  const dur=2200;
  const tickPct=now=>{
    if(done)return;
    const p=Math.min((now-t0)/dur,1);
    const eased=1-Math.pow(1-p,3);
    const val=Math.round(eased*100);
    if(pctEl)pctEl.textContent=String(val).padStart(2,'0')+'%';
    if(statusEl){
      statusEl.textContent=val<38?'CALIBRATING P&ID TELEMETRY':val<78?'SYNTHESIZING VIE FLUOROPHORE':'PORTFOLIO ARCHIVE READY';
    }
    if(p<1)requestAnimationFrame(tickPct);
  };
  requestAnimationFrame(tickPct);
  const end=()=>{if(done)return;done=true;finishIntro();};
  setTimeout(end,2650);
  introEl?.addEventListener('click',end);
  window.addEventListener('keydown',end,{once:true});
}else{
  requestAnimationFrame(()=>document.body.classList.add('page-ready'));
}

// Theme toggle
const themeBtn=document.getElementById('themeToggle');
const metaTheme=document.querySelector('meta[name="theme-color"]');
const paintTheme=()=>{
  const dark=document.documentElement.dataset.theme==='dark';
  if(themeBtn)themeBtn.textContent=dark?'☀':'☾';
  if(metaTheme)metaTheme.setAttribute('content',dark?'#141210':'#faf8f3');
};
paintTheme();
themeBtn?.addEventListener('click',()=>{
  const next=document.documentElement.dataset.theme==='dark'?'light':'dark';
  document.documentElement.dataset.theme=next;
  try{localStorage.setItem('theme',next);}catch(e){}
  paintTheme();
});

// Keep scroll-linked work in a single animation frame.
let scrollTick=false;
const ambientEl=document.querySelector('.ambient-canvas');
const backTopBtn=document.getElementById('backTop');
backTopBtn?.addEventListener('click',()=>{
  window.scrollTo({top:0,behavior:reduceMotion?'auto':'smooth'});
});
const updateScrollMotion=()=>{
  const maxScroll=document.documentElement.scrollHeight-window.innerHeight;
  const p=maxScroll>0?(window.scrollY/maxScroll)*100:0;
  document.getElementById('scrollLine').style.width=p+'%';
  document.querySelector('nav').classList.toggle('scrolled',window.scrollY>24);
  if(backTopBtn){
