  const pvWrap = document.getElementById('busuanzi_container_site_pv');
  if(!pvNumEl) return;
  if(pvWrap) pvWrap.style.setProperty('display','inline-flex','important');
  let localHits = 1, cachedReal = 0, sessionCounted = false;
  try{
    localStorage.removeItem('zts_remote_pv');
    localHits = parseInt(localStorage.getItem('zts_real_local_hits')||'0',10)||0;
    cachedReal = parseInt(localStorage.getItem('zts_real_pv')||'0',10)||0;
    sessionCounted = sessionStorage.getItem('zts_real_pv_counted')==='1';
    if(!sessionCounted){
      localHits += 1;
      localStorage.setItem('zts_real_local_hits', String(localHits));
      sessionStorage.setItem('zts_real_pv_counted', '1');
    }
  }catch{}
  let currentPv = Math.max(1, localHits, cachedReal);
  const renderPv = (val) => {
    const n = Math.max(currentPv, Math.floor(Number(val)||0));
    currentPv = n;
    pvNumEl.textContent = n.toLocaleString('en-US');
    try{ localStorage.setItem('zts_real_pv', String(n)); }catch{}
  };
  renderPv(currentPv);
  const endpoint = sessionCounted
    ? 'https://abacus.jasoncameron.dev/get/zts666.me/real_pv'
    : 'https://abacus.jasoncameron.dev/hit/zts666.me/real_pv';
  const ctrl = typeof AbortController!=='undefined' ? new AbortController() : null;
  const timer = ctrl ? setTimeout(()=>ctrl.abort(), 4500) : null;
  fetch(endpoint, {mode:'cors', signal:ctrl?.signal})
    .then(r=>r.ok?r.json():null)
    .then(data=>{ if(data && typeof data.value==='number' && data.value>0) renderPv(data.value); })
    .catch(()=>{})
    .finally(()=>{ if(timer) clearTimeout(timer); });
  ['busuanzi_site_pv','busuanzi_value_site_pv'].forEach(id=>{
    const el = document.getElementById(id);
    if(!el || typeof MutationObserver==='undefined') return;
    new MutationObserver(()=>{
      const num = parseInt((el.textContent||'').replace(/[^\d]/g,''), 10);
      if(num > 0) renderPv(num);
    }).observe(el, {childList:true, characterData:true, subtree:true});
  });
})();

