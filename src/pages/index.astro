<script is:inline src="https://cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js" defer></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --ink:#1a1916;--ink2:#4a4845;--ink3:#9a9894;
  --bg:#faf8f3;--bg2:#f0ede4;--bg3:#e8e4d8;
  --line:rgba(26,25,22,0.12);
  --accent:#8b3a2a;--accent2:#b85c38;
  --serif:'Playfair Display','Noto Serif SC',Georgia,serif;
  --mono:'IBM Plex Mono','Courier New',monospace;
  --sans:'PingFang SC','Hiragino Sans GB','Microsoft YaHei',system-ui,sans-serif;
  --card:rgba(250,248,243,0.75);--card2:rgba(240,237,228,0.72);
  --nav-bg:rgba(250,248,243,0.92);--nav-bg2:rgba(250,248,243,.84);--menu-bg:rgba(250,248,243,0.98);
}
html[data-theme="dark"]{
  --ink:#ece7dc;--ink2:#bdb7aa;--ink3:#8a857a;
  --bg:#141210;--bg2:#1d1a16;--bg3:#27231d;
  --line:rgba(236,231,220,0.15);
  --accent:#e0886a;--accent2:#f0a583;
  --card:rgba(24,21,18,0.78);--card2:rgba(29,26,22,0.72);
  --nav-bg:rgba(20,18,16,0.9);--nav-bg2:rgba(20,18,16,.82);--menu-bg:rgba(20,18,16,0.98);
  color-scheme:dark;
}
html[data-theme="dark"] .ambient-canvas{filter:invert(1) hue-rotate(180deg) brightness(.72);}
html[data-theme="dark"] .portrait img,html[data-theme="dark"] .cert-img-wrap img{filter:brightness(.92);}
body{transition:background .35s ease,color .35s ease;}
html{scroll-behavior:smooth;overflow-x:clip;}
body{font-family:var(--sans);background:var(--bg);color:var(--ink);font-size:15px;line-height:1.8;overflow-x:clip;}

/* NOISE */
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:9999;opacity:0.35;
background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;background:var(--nav-bg);backdrop-filter:blur(10px);
  border-bottom:0.5px solid var(--line);padding:0 2.5rem;height:52px;display:flex;align-items:center;justify-content:space-between;}
.nav-logo{font-family:var(--serif);font-size:17px;font-weight:700;color:var(--ink);text-decoration:none;letter-spacing:-0.3px;flex-shrink:0;white-space:nowrap;}
.nav-links{display:flex;gap:2rem;list-style:none;}
.nav-links a{font-family:var(--mono);font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink3);text-decoration:none;transition:color 0.2s;}
.nav-links a:hover{color:var(--accent);}
.nav-badge{font-family:var(--mono);font-size:9px;padding:2px 7px;background:var(--accent);color:var(--bg);letter-spacing:0.1em;margin-left:6px;vertical-align:middle;}
.nav-toggle{display:none;background:transparent;border:0.5px solid var(--line);padding:5px 10px;font-family:var(--mono);font-size:10px;letter-spacing:0.12em;color:var(--ink);cursor:pointer;text-transform:uppercase;}
.mobile-menu{display:none;position:fixed;top:52px;left:0;right:0;bottom:0;background:var(--menu-bg);backdrop-filter:blur(12px);z-index:99;padding:1.5rem 1.5rem 2rem;flex-direction:column;gap:0;overflow-y:auto;}
.mobile-menu.open{display:flex;}
.mobile-menu a{display:flex;align-items:baseline;gap:1rem;padding:1rem 0;border-bottom:0.5px solid var(--line);text-decoration:none;color:var(--ink);font-family:var(--serif);font-size:20px;font-weight:700;}
.mobile-menu a span{font-family:var(--mono);font-size:10px;color:var(--accent);letter-spacing:0.12em;font-weight:400;}

/* SCROLL BAR (anchored at bottom of nav) */
.scroll-line{position:absolute;bottom:-1px;left:0;height:2px;background:var(--accent);width:0%;z-index:200;transition:width 0.08s linear;pointer-events:none;}

/* CONTAINER */
.container{max-width:960px;margin:0 auto;padding:0 2.5rem;}

/* ── HERO ── */
#hero{padding-top:52px;min-height:100vh;display:flex;flex-direction:column;justify-content:center;border-bottom:0.5px solid var(--line);}
.hero-inner{padding:4rem 2.5rem;max-width:960px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 300px;gap:0;align-items:start;
  animation:fadeUp 0.8s ease 0.05s both;}

@keyframes fadeUp{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}

.hero-left{padding-right:3rem;border-right:0.5px solid var(--line);}
.masthead-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem;padding-bottom:1rem;border-bottom:2px solid var(--ink);}
.edition{font-size:10px;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink3);}
.mag-title{font-family:var(--serif);font-size:13px;font-weight:700;letter-spacing:0.05em;color:var(--ink);}
.kicker{font-size:10px;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent);margin-bottom:1rem;display:flex;align-items:center;gap:8px;}
.kicker::before{content:'';display:block;width:20px;height:1px;background:var(--accent);}
h1.headline{font-family:var(--serif);font-size:clamp(34px,4.5vw,54px);font-weight:900;line-height:1.1;letter-spacing:-1.5px;color:var(--ink);margin-bottom:1.4rem;}
h1.headline em{font-style:italic;color:var(--accent);}
.hero-body{font-size:15px;line-height:1.95;color:var(--ink2);margin-bottom:1.6rem;}
.hero-cta{display:flex;gap:1rem;flex-wrap:wrap;}
.btn-primary{font-family:var(--mono);font-size:10px;letter-spacing:0.15em;text-transform:uppercase;padding:10px 22px;
  background:var(--ink);color:var(--bg);border:none;cursor:pointer;text-decoration:none;transition:background 0.2s,transform 0.15s;}
.btn-primary:hover{background:var(--accent);transform:translateY(-1px);}
.btn-ghost{font-family:var(--mono);font-size:10px;letter-spacing:0.15em;text-transform:uppercase;padding:10px 22px;
  background:transparent;color:var(--ink);border:0.5px solid var(--ink);text-decoration:none;transition:all 0.2s;}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent);}

.hero-right{padding-left:3rem;}
.portrait{width:100%;aspect-ratio:3/4;border:0.5px solid var(--line);background:var(--bg2);overflow:hidden;position:relative;margin-bottom:1rem;}
.portrait img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;}
.portrait-label{position:absolute;bottom:0;left:0;right:0;background:var(--ink);color:var(--bg);font-size:9px;
  letter-spacing:0.13em;text-transform:uppercase;padding:7px 12px;display:flex;justify-content:space-between;}

.stat-row{display:grid;grid-template-columns:1fr 1fr;gap:0;border:0.5px solid var(--line);}
.stat-item{padding:0.8rem;border-right:0.5px solid var(--line);border-bottom:0.5px solid var(--line);}
.stat-item:nth-child(2n){border-right:none;}
.stat-item:nth-last-child(-n+2){border-bottom:none;}
.stat-num{font-family:var(--serif);font-size:22px;font-weight:700;color:var(--ink);line-height:1;margin-bottom:3px;}
.stat-label{font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink3);}

/* SECTIONS */
section{padding:5rem 0;border-bottom:0.5px solid var(--line);opacity:0;transform:translateY(20px);transition:opacity 0.65s ease,transform 0.65s ease;}
section.visible{opacity:1;transform:translateY(0);}
.section-header{display:flex;align-items:baseline;gap:1rem;margin-bottom:2.5rem;padding-bottom:1rem;border-bottom:0.5px solid var(--line);}
.section-num{font-size:10px;color:var(--ink3);letter-spacing:0.1em;}
h2.section-title{font-family:var(--serif);font-size:26px;font-weight:700;letter-spacing:-0.5px;color:var(--ink);}
h2.section-title em{font-style:italic;color:var(--accent);}
.section-rule{flex:1;height:0.5px;background:var(--line);}

/* ABOUT */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start;}
.about-text p{font-size:14.5px;line-height:1.95;color:var(--ink2);margin-bottom:1rem;}
.pull-quote{border-left:3px solid var(--accent);padding:1rem 1.4rem;background:var(--bg2);margin:1.5rem 0;}
.pull-quote p{font-family:var(--serif);font-style:italic;font-size:15px !important;line-height:1.65 !important;color:var(--ink) !important;margin-bottom:5px !important;}
.pull-quote cite{font-size:10px;color:var(--ink3);letter-spacing:0.1em;display:block;}

.timeline{list-style:none;}
.timeline-item{display:grid;grid-template-columns:90px 1fr;gap:0.8rem;padding:1rem 0;border-bottom:0.5px solid var(--line);}
.timeline-item:last-child{border-bottom:none;}
.tl-year{font-family:var(--mono);font-size:11px;color:var(--accent);font-weight:500;padding-top:3px;letter-spacing:0.05em;}
.tl-org{font-size:14px;font-weight:600;color:var(--ink);margin-bottom:3px;}
.tl-role{font-size:12.5px;color:var(--ink3);}

/* ACADEMICS */
.academics-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:0.5px solid var(--line);background:var(--card);}
.acad-card{padding:1.3rem;border-right:0.5px solid var(--line);text-align:center;}
.acad-card:last-child{border-right:none;}
.acad-big{font-family:var(--serif);font-size:32px;font-weight:900;color:var(--ink);line-height:1;margin-bottom:5px;}
.acad-big span{font-size:14px;font-weight:400;}
.acad-label{font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:var(--ink3);}
.acad-sub{font-size:10px;color:var(--accent);margin-top:4px;font-weight:500;}

.research-box{border:0.5px solid var(--line);padding:1.5rem;margin-top:1.5rem;background:var(--bg2);}
.research-title{font-size:9px;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink3);margin-bottom:1rem;padding-bottom:8px;border-bottom:0.5px solid var(--line);}
.research-content{display:grid;grid-template-columns:1fr 1fr;gap:2rem;}
.research-item-title{font-family:var(--serif);font-size:16px;font-weight:700;color:var(--ink);margin-bottom:6px;}
.research-item-title em{font-style:italic;}
.research-item-desc{font-size:13.5px;line-height:1.85;color:var(--ink2);}

/* SKILLS */
.skills-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:0.5px solid var(--line);background:var(--card);}
.skill-card{padding:1.4rem;border-right:0.5px solid var(--line);border-bottom:0.5px solid var(--line);transition:background 0.2s;display:flex;flex-direction:column;}
.skill-card:hover{background:var(--bg2);}
.skill-card:nth-child(3n){border-right:none;}
.skill-card:nth-last-child(-n+3){border-bottom:none;}
.skill-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;}
.skill-cat{font-family:var(--mono);font-size:9px;letter-spacing:0.15em;text-transform:uppercase;color:var(--accent);}
.skill-level{font-family:var(--mono);font-size:9px;padding:2px 6px;border:0.5px solid var(--line);color:var(--ink2);background:var(--bg2);letter-spacing:0.06em;}
.skill-level.core{border-color:rgba(139,58,42,0.35);color:var(--accent);background:rgba(139,58,42,0.06);}
.skill-name{font-family:var(--serif);font-size:16px;font-weight:700;color:var(--ink);margin-bottom:8px;}
.skill-evidence{font-size:12.5px;line-height:1.7;color:var(--ink2);margin-bottom:12px;flex:1;}
.skill-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:auto;}
.tag{font-family:var(--mono);font-size:10px;padding:3px 7px;border:0.5px solid var(--line);color:var(--ink3);letter-spacing:0.04em;transition:all 0.2s;}
.tag:hover{border-color:var(--accent);color:var(--accent);}

/* ACTIVITIES */
.activities-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;}
.activity-card{border:0.5px solid var(--line);padding:1.4rem;background:var(--card);}
.ac-icon{font-family:var(--mono);font-size:9px;letter-spacing:0.15em;text-transform:uppercase;color:var(--accent);margin-bottom:8px;}
.ac-title{font-family:var(--serif);font-size:16px;font-weight:700;color:var(--ink);margin-bottom:6px;}
.ac-desc{font-size:13.5px;line-height:1.85;color:var(--ink2);}
.ac-badge{font-family:var(--mono);display:inline-block;font-size:9px;padding:2px 8px;background:var(--ink);color:var(--bg);letter-spacing:0.1em;margin-top:10px;}
.ac-badge.green{background:#3a7a5a;}

/* CERTIFICATES */
.certs-intro{font-size:13.5px;line-height:1.85;color:var(--ink2);margin-bottom:1.5rem;}
.certs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:0.5px solid var(--line);background:var(--card);}
.cert-item{border-right:0.5px solid var(--line);border-bottom:0.5px solid var(--line);overflow:hidden;cursor:pointer;transition:background 0.2s;}
.cert-item:hover{background:var(--bg2);}
.cert-item:nth-child(3n){border-right:none;}
.cert-item:nth-last-child(-n+3){border-bottom:none;}
.cert-img-wrap{width:100%;aspect-ratio:4/3;overflow:hidden;background:var(--bg3);}
.cert-img-wrap img{width:100%;height:100%;object-fit:cover;transition:transform 0.4s;}
.cert-item:hover .cert-img-wrap img{transform:scale(1.04);}
.cert-caption{padding:0.85rem;border-top:0.5px solid var(--line);}
.cert-name{font-size:13px;font-weight:600;color:var(--ink);margin-bottom:2px;}
.cert-date{font-family:var(--mono);font-size:10px;color:var(--ink3);letter-spacing:0.06em;}

/* CONTACT */
.contact-layout{display:grid;grid-template-columns:1fr 1fr;gap:3rem;}
.contact-intro{font-size:14px;line-height:1.95;color:var(--ink2);margin-bottom:2rem;}
.contact-links{display:flex;flex-direction:column;gap:0;}
.contact-link-item{display:flex;align-items:center;justify-content:space-between;padding:1rem 0;border-bottom:0.5px solid var(--line);text-decoration:none;color:var(--ink);transition:all 0.2s;background:transparent;border-left:none;border-right:none;border-top:none;width:100%;text-align:left;font-family:inherit;cursor:pointer;}
.contact-link-item:first-child{border-top:0.5px solid var(--line);}
.contact-link-item:hover{padding-left:8px;color:var(--accent);}
.contact-link-item.static{cursor:default;}
.contact-link-item.static:hover{padding-left:0;color:var(--ink);}
.cl-left{display:flex;flex-direction:column;gap:2px;}
.cl-label{font-family:var(--mono);font-size:9px;letter-spacing:0.15em;text-transform:uppercase;color:var(--ink3);}
.cl-val{font-family:var(--mono);font-size:13px;font-weight:500;}
.cl-arrow{font-family:var(--mono);font-size:10px;letter-spacing:0.1em;color:var(--ink3);transition:transform 0.2s,color 0.2s;}
.contact-link-item:hover .cl-arrow{transform:translateX(4px);color:var(--accent);}
.aside-col{display:flex;flex-direction:column;gap:1.2rem;}
.aside-box{border:0.5px solid var(--line);padding:1.3rem;background:var(--bg2);}
.aside-title{font-family:var(--mono);font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:var(--ink3);margin-bottom:0.8rem;padding-bottom:7px;border-bottom:0.5px solid var(--line);}
.aside-text{font-size:13.5px;line-height:1.85;color:var(--ink2);}
.status-dot{width:8px;height:8px;border-radius:50%;background:#3a7a5a;display:inline-block;margin-right:6px;vertical-align:middle;}

/* FOOTER */
.ornament{text-align:center;color:var(--ink3);font-size:11px;letter-spacing:0.3em;margin:2rem auto 1rem;max-width:960px;padding:0 2.5rem;}
footer{padding:1.8rem 2.5rem;border-top:2px solid var(--ink);display:flex;justify-content:space-between;align-items:center;max-width:960px;margin:0 auto;}
.footer-copy{font-size:10px;color:var(--ink3);letter-spacing:0.08em;}
.footer-sig{font-family:var(--serif);font-style:italic;font-size:13px;color:var(--ink2);}
.visit-counter{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border:0.5px solid var(--line);background:var(--card2);color:var(--ink3);white-space:nowrap;}
.visit-counter::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 0 rgba(139,58,42,.24);animation:visitPulse 2.4s ease-out infinite;}
.visit-label{font-size:8px;letter-spacing:0.14em;text-transform:uppercase;}
.visit-counter strong{min-width:2ch;font-family:var(--serif);font-size:15px;line-height:1;color:var(--accent);font-variant-numeric:tabular-nums;}
.visit-unit{font-size:8px;color:var(--ink3);}
@keyframes visitPulse{0%{box-shadow:0 0 0 0 rgba(139,58,42,.24);}70%,100%{box-shadow:0 0 0 6px rgba(139,58,42,0);}}

/* LIGHTBOX */
.lightbox{display:none;position:fixed;inset:0;background:rgba(26,25,22,0.92);z-index:1000;align-items:center;justify-content:center;flex-direction:column;gap:0.9rem;padding:2rem;}
.lightbox.open{display:flex;}
.lightbox img{max-width:84vw;max-height:78vh;object-fit:contain;border:0.5px solid rgba(255,255,255,0.18);}
.lb-close{position:absolute;top:1.25rem;right:1.5rem;color:rgba(250,248,243,0.85);font-size:12px;cursor:pointer;font-family:var(--mono);letter-spacing:0.12em;background:rgba(255,255,255,0.06);border:0.5px solid rgba(255,255,255,0.22);padding:6px 12px;text-transform:uppercase;}
.lb-close:hover{background:var(--accent);border-color:var(--accent);color:#fff;}
.lb-nav{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,0.07);border:0.5px solid rgba(255,255,255,0.22);color:rgba(250,248,243,0.9);width:42px;height:42px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-family:var(--mono);font-size:16px;transition:all 0.2s;}
.lb-nav:hover{background:var(--accent);border-color:var(--accent);color:#fff;}
.lb-prev{left:1.5rem;}
.lb-next{right:1.5rem;}
.lb-caption-bar{display:flex;align-items:center;gap:0.9rem;color:rgba(250,248,243,0.9);font-size:13px;}
.lb-counter{font-family:var(--mono);font-size:11px;color:var(--accent2);letter-spacing:0.12em;}

/* COPY TOAST */
.copy-toast{position:fixed;bottom:2rem;left:50%;transform:translateX(-50%) translateY(14px);background:var(--ink);color:var(--bg);font-family:var(--mono);font-size:11px;letter-spacing:0.08em;padding:9px 18px;border:0.5px solid var(--accent);opacity:0;pointer-events:none;transition:opacity 0.25s,transform 0.25s;z-index:1100;}
.copy-toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* RESPONSIVE */
