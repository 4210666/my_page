const langBtn=document.getElementById('langToggle');
const applyLang=(lang)=>{
  const isEn=lang==='en';
  document.documentElement.dataset.lang=lang;
  document.documentElement.lang=isEn?'en':'zh-CN';
  if(langBtn)langBtn.textContent=isEn?'中':'EN';
  const dEl=document.getElementById('today-date');
  if(dEl)dEl.textContent=d.toLocaleDateString(isEn?'en-US':'zh-CN',{year:'numeric',month:'long',day:'numeric'});
  i18nNodes.forEach(([sel,zh,en,html])=>{
    const el=document.querySelector(sel);
    if(!el)return;
    if(html)el.innerHTML=isEn?en:zh;
    else el.textContent=isEn?en:zh;
  });
  // Form label text nodes & placeholders
  const qm=document.getElementById('quickMail');
  if(qm){
    const labels=qm.querySelectorAll('label');
    const lblText=isEn?['Your Role\n','Your Name\n','Message\n']:['您的身份\n','称呼\n','留言\n'];
    labels.forEach((lbl,i)=>{
      const tn=[...lbl.childNodes].find(n=>n.nodeType===Node.TEXT_NODE);
      if(tn&&lblText[i])tn.textContent=lblText[i];
    });
    const whoIn=qm.querySelector('input[name="who"]');
    if(whoIn)whoIn.placeholder=isEn?'e.g., Prof. Wang / Acme HR':'如：王老师 / 某某公司 HR';
    const msgIn=qm.querySelector('textarea[name="msg"]');
    if(msgIn)msgIn.placeholder=isEn?'How can we collaborate?':'想和我聊些什么？';
  }
  // Video toggle button in CatalysisProject
  const vToggle=document.querySelector('#projects .video-toggle');
  const vLabel=vToggle?.querySelector('.toggle-label');
  if(vToggle&&vLabel){
    const paused=vToggle.getAttribute('aria-pressed')==='true';
    vLabel.textContent=paused?(isEn?'Play':'播放演示'):(isEn?'Pause':'暂停演示');
  }
  paintNavToggle();
  paintCourseToggle();
  if(lbEl?.classList.contains('open'))renderLb();
};
if(document.documentElement.dataset.lang==='en')applyLang('en');
langBtn?.addEventListener('click',()=>{
  const next=document.documentElement.dataset.lang==='en'?'zh':'en';
  try{localStorage.setItem('lang',next);}catch(e){}
  applyLang(next);
});

